<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - CareerSphere</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #1a1a2e;
            --secondary: #16213e;
            --gradient-start: #667eea;
            --gradient-end: #764ba2;
            --surface: #f5f6fa;
            --text-dark: #1a1a2e;
            --text-muted: #6c757d;
            --border-radius: 16px;
            --gold: #f59e0b;
            --gold-light: #fef3c7;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Inter', sans-serif;
            color: var(--text-dark);
            background: var(--surface);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(16px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes slideDown {
            from { transform: translateY(-100%); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-12px); }
        }
        @keyframes shimmer {
            0% { background-position: -200% center; }
            100% { background-position: 200% center; }
        }

        /* NAV */
        nav {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
            animation: slideDown 0.5s ease-out;
            position: sticky; top: 0; z-index: 100;
        }
        .nav-container {
            max-width: 1300px;
            margin: 0 auto;
            padding: 1.25rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .nav-logo { display: flex; align-items: center; gap: 0.9rem; }
        .logo-icon { font-size: 2.2rem; }
        .logo-text h1 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.7rem;
            font-weight: 400;
        }
        .logo-text p { font-size: 0.72rem; color: rgba(255,255,255,0.7); margin-top: 2px; }
        .nav-right { display: flex; align-items: center; gap: 1.5rem; }
        .nav-links { display: flex; gap: 0.25rem; }
        .nav-link {
            color: rgba(255,255,255,0.8);
            text-decoration: none;
            font-size: 0.88rem;
            font-weight: 500;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            transition: all 0.2s;
        }
        .nav-link:hover { background: rgba(255,255,255,0.12); color: white; }
        .nav-user { display: flex; align-items: center; gap: 0.75rem; }
        .user-info { text-align: right; }
        .user-info p:first-child { font-size: 0.9rem; font-weight: 600; }
        .user-info p:last-child { font-size: 0.72rem; color: rgba(255,255,255,0.7); }
        .user-avatar {
            width: 44px; height: 44px;
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 1.1rem;
            border: 2px solid rgba(255,255,255,0.3);
        }

        /* MAIN */
        main {
            flex: 1;
            max-width: 1300px;
            margin: 0 auto;
            width: 100%;
            padding: 3rem 2rem;
        }

        /* WELCOME */
        .welcome-section {
            margin-bottom: 2rem;
            animation: fadeIn 0.5s ease-out 0.1s both;
        }
        .welcome-section h2 {
            font-family: 'DM Serif Display', serif;
            font-size: 2.6rem;
            color: var(--primary);
            font-weight: 400;
            margin-bottom: 0.5rem;
        }
        .welcome-section p { font-size: 1.1rem; color: var(--text-muted); }

        /* DISCLAIMER */
        .trust-disclaimer {
            background: linear-gradient(135deg, #e0e7ff, #f3e8ff);
            border: 1.5px solid rgba(102,126,234,0.2);
            border-radius: var(--border-radius);
            padding: 1.25rem 1.75rem;
            margin-bottom: 2.5rem;
            font-size: 0.9rem;
            color: var(--text-dark);
            line-height: 1.7;
            animation: fadeIn 0.5s ease-out 0.15s both;
        }
        .trust-disclaimer strong { color: var(--gradient-start); }

        /* TWO COLUMN HERO */
        .hero-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            margin-bottom: 2.5rem;
        }

        /* HERO CARD BASE */
        .hero-card {
            border-radius: var(--border-radius);
            overflow: hidden;
            box-shadow: 0 8px 40px rgba(0,0,0,0.08);
            border: 1px solid rgba(0,0,0,0.05);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            display: flex;
            flex-direction: column;
        }
        .hero-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 60px rgba(0,0,0,0.12);
        }

        /* ASSESSMENT CARD */
        .assessment-card { animation: fadeIn 0.5s ease-out 0.2s both; }
        .assessment-card .card-header {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            padding: 2rem 2rem 1.5rem;
            color: white;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        .assessment-card .card-header::before {
            content: '';
            position: absolute; top: -40%; right: -10%;
            width: 200px; height: 200px;
            background: radial-gradient(circle, rgba(255,255,255,0.08), transparent 70%);
            border-radius: 50%;
        }
        .card-header-icon {
            font-size: 3.5rem;
            display: block;
            margin-bottom: 0.75rem;
            animation: float 4s ease-in-out infinite;
        }
        .card-header h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.6rem;
            font-weight: 400;
            margin-bottom: 0.4rem;
        }
        .card-header p { font-size: 0.88rem; color: rgba(255,255,255,0.75); }

        .card-body {
            background: white;
            padding: 1.75rem 2rem;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .features-list { list-style: none; margin-bottom: 1.75rem; flex: 1; }
        .features-list li {
            padding: 0.55rem 0;
            font-size: 0.92rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            color: var(--text-dark);
            border-bottom: 1px solid #f0f0f0;
        }
        .features-list li:last-child { border-bottom: none; }
        .features-list li::before {
            content: '✓';
            color: var(--gradient-start);
            font-weight: 700;
            font-size: 0.95rem;
            flex-shrink: 0;
        }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.6rem;
            padding: 0.9rem 2rem;
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
            color: white;
            border: none;
            border-radius: 100px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 6px 24px rgba(102,126,234,0.3);
            width: 100%;
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 32px rgba(102,126,234,0.4);
        }

        .time-note {
            margin-top: 1rem;
            font-size: 0.8rem;
            color: var(--text-muted);
            text-align: center;
        }

        /* RESUME CARD — GOLD THEME */
        .resume-card { animation: fadeIn 0.5s ease-out 0.3s both; }
        .resume-card .card-header {
            background: linear-gradient(135deg, #92400e, #b45309);
            padding: 2rem 2rem 1.5rem;
            color: white;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        .resume-card .card-header::before {
            content: '';
            position: absolute; top: -40%; left: -10%;
            width: 200px; height: 200px;
            background: radial-gradient(circle, rgba(255,255,255,0.1), transparent 70%);
            border-radius: 50%;
        }

        .new-badge {
            position: absolute;
            top: 14px; right: 14px;
            background: var(--gold);
            color: #1a1a2e;
            font-size: 0.65rem;
            font-weight: 800;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 3px 10px;
            border-radius: 100px;
        }

        .btn-gold {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.6rem;
            padding: 0.9rem 2rem;
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: white;
            border: none;
            border-radius: 100px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 6px 24px rgba(245,158,11,0.35);
            width: 100%;
        }
        .btn-gold:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 32px rgba(245,158,11,0.5);
        }

        /* FEATURES GRID */
        .section-title {
            font-family: 'DM Serif Display', serif;
            font-size: 2rem;
            color: var(--primary);
            font-weight: 400;
            margin-bottom: 1.5rem;
            animation: fadeIn 0.5s ease-out 0.35s both;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.25rem;
            margin-bottom: 2.5rem;
        }

        .feature-card {
            background: white;
            border-radius: var(--border-radius);
            padding: 1.75rem;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            border: 1px solid rgba(0,0,0,0.05);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }
        .feature-card::after {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; height: 3px;
            background: linear-gradient(90deg, var(--gradient-start), var(--gradient-end));
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }
        .feature-card:hover::after { transform: scaleX(1); }
        .feature-card:hover { transform: translateY(-5px); box-shadow: 0 12px 40px rgba(0,0,0,0.1); }
        .feature-card:nth-child(1) { animation: fadeIn 0.5s ease-out 0.4s both; }
        .feature-card:nth-child(2) { animation: fadeIn 0.5s ease-out 0.45s both; }
        .feature-card:nth-child(3) { animation: fadeIn 0.5s ease-out 0.5s both; }
        .feature-card:nth-child(4) { animation: fadeIn 0.5s ease-out 0.55s both; }

        .feature-icon {
            width: 56px; height: 56px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
            display: flex; align-items: center; justify-content: center;
            font-size: 1.6rem;
            margin-bottom: 1.1rem;
            transition: transform 0.3s;
        }
        .feature-card:hover .feature-icon { transform: scale(1.1) rotate(5deg); }
        .feature-card h4 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.2rem;
            font-weight: 400;
            color: var(--primary);
            margin-bottom: 0.5rem;
        }
        .feature-card p { font-size: 0.85rem; color: var(--text-muted); line-height: 1.55; }

        /* FOOTER */
        footer {
            background: white;
            border-top: 1px solid rgba(0,0,0,0.07);
            padding: 2rem;
            animation: fadeIn 0.5s ease-out 0.6s both;
        }
        .footer-content {
            max-width: 1300px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }
        .footer-left p { font-size: 0.85rem; color: var(--text-muted); }
        .footer-links { display: flex; gap: 1.5rem; }
        .footer-links a {
            color: var(--gradient-start);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: color 0.2s;
        }
        .footer-links a:hover { color: var(--gradient-end); }

        @media (max-width: 1024px) {
            .features-grid { grid-template-columns: repeat(2, 1fr); }
        }
        @media (max-width: 768px) {
            .hero-grid { grid-template-columns: 1fr; }
            .features-grid { grid-template-columns: 1fr 1fr; }
            .nav-links { display: none; }
            .user-info { display: none; }
            main { padding: 2rem 1.25rem; }
            .welcome-section h2 { font-size: 2rem; }
        }
        @media (max-width: 480px) {
            .features-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

<!-- NAV -->
<nav>
    <div class="nav-container">
        <div class="nav-logo">
            <div class="logo-icon">🌐</div>
            <div class="logo-text">
                <h1>CareerSphere</h1>
                <p>Your AI Career Companion</p>
            </div>
        </div>
        <div class="nav-right">
            <div class="nav-links">
                <a href="/assessment" class="nav-link">Assessment</a>
                <a href="/resume" class="nav-link">Resume Builder</a>
            </div>
            <div class="nav-user">
                <div class="user-info">
                    <p><%= user.name %></p>
                    <p><%= user.email %></p>
                </div>
                <div class="user-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
            </div>
        </div>
    </div>
</nav>

<main>

    <!-- WELCOME -->
    <div class="welcome-section">
        <h2>Welcome back, <%= user.name %>! 👋</h2>
        <p>Ready to take the next step in your career journey?</p>
    </div>

    <!-- DISCLAIMER -->
    <div class="trust-disclaimer">
        🔒 <strong>CareerSphere is a student-built educational platform.</strong>
        This application provides AI-generated career guidance for learning purposes only.
        We do not collect financial information, do not offer paid services, and do not share user data with third parties.
    </div>

    <!-- HERO: TWO CARDS -->
    <div class="hero-grid">

        <!-- Assessment Card -->
        <div class="hero-card assessment-card">
            <div class="card-header">
                <span class="card-header-icon">🎯</span>
                <h3>Career Assessment</h3>
                <p>Discover your ideal career path with AI</p>
            </div>
            <div class="card-body">
                <ul class="features-list">
                    <li>Comprehensive skill & interest analysis</li>
                    <li>AI-powered career matching</li>
                    <li>Personalized learning roadmap</li>
                    <li>Skill gap identification</li>
                </ul>
                <a href="/assessment" class="btn-primary">Start Assessment →</a>
                <p class="time-note">⏱️ Takes approximately 5–10 minutes</p>
            </div>
        </div>

        <!-- Resume Card -->
        <div class="hero-card resume-card">
            <div class="card-header">
                <span class="new-badge">✨</span>
                <span class="card-header-icon">📄</span>
                <h3>Resume Builder</h3>
                <p>Create a job-ready resume in minutes</p>
            </div>
            <div class="card-body">
                <ul class="features-list">
                    <li>Professional, ATS-friendly templates</li>
                    <li>Fill-in-the-blank simple form</li>
                    <li>Instant PDF download</li>
                    <li>Tailored layout for any industry</li>
                </ul>
                <a href="/resume" class="btn-gold">Build My Resume →</a>
                <p class="time-note">📝 Ready to download in under 5 minutes</p>
            </div>
        </div>

    </div>

    <!-- FEATURES -->
    <h3 class="section-title">What You'll Get</h3>
    <div class="features-grid">
        <div class="feature-card">
            <div class="feature-icon">📊</div>
            <h4>Skill Analysis</h4>
            <p>Comprehensive evaluation of your technical and soft skills</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">🎯</div>
            <h4>Career Matches</h4>
            <p>Top career paths tailored to your profile and goals</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">🗺️</div>
            <h4>Learning Roadmap</h4>
            <p>Step-by-step plan to achieve your career objectives</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">📄</div>
            <h4>Resume Builder</h4>
            <p>Build a polished, professional resume ready for any job application</p>
        </div>
    </div>

</main>

<!-- FOOTER -->
<footer>
    <div class="footer-content">
        <div class="footer-left">
            <p>© 2026 CareerSphere. An educational AI career guidance project.</p>
        </div>
        <div class="footer-links">
            <a href="/assessment">Assessment</a>
            <a href="/resume">Resume Builder</a>
        </div>
    </div>
</footer>

</body>
</html>